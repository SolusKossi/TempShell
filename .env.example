# Copy to .env before running. Never commit the real .env.
#
#   OWNER_PASSWORD_HASH   node scripts/hash-password.mjs 'your password'
#   COOKIE_SECRET         openssl rand -base64 48
#   API_TOKEN             openssl rand -hex 32
#
# PUBLIC_URL is the address the world reaches this instance at. It is baked into
# the agent that the target machine pastes, so it must be correct and reachable.

PUBLIC_URL=https://tempshell.example.com
OWNER_PASSWORD_HASH=scrypt:...:...
COOKIE_SECRET=
API_TOKEN=
